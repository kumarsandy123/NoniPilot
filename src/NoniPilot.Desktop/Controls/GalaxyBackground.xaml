<UserControl x:Class="NoniPilot.Desktop.Controls.GalaxyBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True">
    <Grid Background="{StaticResource Bg}">
        <!--
            Galaxy disk and nebula clouds are deliberately STATIC (no RotateTransform/
            TranslateTransform animation) - measured live (2026-09-13): animating these 4 large
            gradient ellipses added ~50 percentage points of continuous CPU (isolated via
            before/after A/B measurement, with and without BitmapCache - caching didn't help,
            confirming the cost was the animation/redraw itself, not gradient re-rendering).
            Removing the animation brought it back to the exact same baseline as no galaxy
            background at all. A static soft glow reads just as "futuristic AI" as a moving one -
            it's the same technique the existing Hero card's own glow ellipse already uses - and
            the twinkling star field below (confirmed ~0% cost) is what actually makes this feel
            "alive" without paying a real, continuous CPU cost for it.
        -->
        <Ellipse Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.15">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8B5CF6" Offset="0" />
                    <GradientStop Color="#22D3EE" Offset="0.55" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleY="0.42" CenterX="450" CenterY="450" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-110,0,0" Opacity="0.21">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22D3EE" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-130,-150" Opacity="0.19">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8B5CF6" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="260,120,0,0" Opacity="0.14">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22D3EE" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Star field - populated in code-behind (positions need real measurements), twinkled
             via a single shared low-frequency timer (see code-behind) - confirmed near-zero CPU
             cost, this is the background's actual "living" element. -->
        <Canvas x:Name="StarCanvas" />
    </Grid>
</UserControl>
