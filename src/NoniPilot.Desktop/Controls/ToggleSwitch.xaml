<UserControl x:Class="NoniPilot.Desktop.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="RootButton" Click="RootButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter />
            </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="LabelText" Foreground="{StaticResource TextDim}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border x:Name="Track" Width="38" Height="20" CornerRadius="10" Background="{StaticResource PanelBorder}">
                <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="{StaticResource TextDim}"
                        HorizontalAlignment="Left" Margin="2,0,0,0" />
            </Border>
        </StackPanel>
    </Button>
</UserControl>
