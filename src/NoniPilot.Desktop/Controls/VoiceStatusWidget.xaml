<UserControl x:Class="NoniPilot.Desktop.Controls.VoiceStatusWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#151A26" CornerRadius="16" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="16,12">
        <StackPanel Orientation="Horizontal">
            <!-- Sci-fi "radar ping" - two rings expanding + fading out from the AI badge,
                 staggered so they never pulse in sync. Simple stroke-only circles (no gradient
                 fill, small size), animating only Scale/Opacity - a fundamentally cheap case,
                 the same category already measured safe this session (unlike large gradient
                 shapes). -->
            <Grid Width="56" Height="56" Margin="0,0,14,0">
                <Ellipse x:Name="PulseRing1" Width="56" Height="56" Stroke="{StaticResource Cyan}" StrokeThickness="1.5"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseRing1Scale" ScaleX="0.6" ScaleY="0.6" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleX"
                                                     From="0.6" To="1.15" Duration="0:00:02.2" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleY"
                                                     From="0.6" To="1.15" Duration="0:00:02.2" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="PulseRing1" Storyboard.TargetProperty="Opacity"
                                                     From="0.6" To="0" Duration="0:00:02.2" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse x:Name="PulseRing2" Width="56" Height="56" Stroke="{StaticResource Violet}" StrokeThickness="1.5"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseRing2Scale" ScaleX="0.6" ScaleY="0.6" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard BeginTime="0:00:01.1">
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleX"
                                                     From="0.6" To="1.15" Duration="0:00:02.2" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleY"
                                                     From="0.6" To="1.15" Duration="0:00:02.2" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="Opacity"
                                                     From="0.6" To="0" Duration="0:00:02.2" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentGradient}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource GlowCyan}">
                    <TextBlock x:Name="BadgeIcon" Text="🎙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PrimaryStatusText" Text="Ready" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <!-- Audio-equalizer-style bars - heights nudged directly by a shared
                         low-frequency timer in code-behind (same technique as the star-field
                         twinkle: no per-bar animation clocks), only while actually
                         listening/talking. -->
                    <Rectangle x:Name="Bar1" Width="3" Height="4" Fill="{StaticResource Cyan}" Margin="0,0,2,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                    <Rectangle x:Name="Bar2" Width="3" Height="4" Fill="{StaticResource Cyan}" Margin="0,0,2,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                    <Rectangle x:Name="Bar3" Width="3" Height="4" Fill="{StaticResource Cyan}" Margin="0,0,2,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                    <Rectangle x:Name="Bar4" Width="3" Height="4" Fill="{StaticResource Cyan}" Margin="0,0,2,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                    <Rectangle x:Name="Bar5" Width="3" Height="4" Fill="{StaticResource Cyan}" Margin="0,0,10,0" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" />
                    <TextBlock x:Name="SecondaryStatusText" Text="Say &quot;Hey Noni&quot; to wake me" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
