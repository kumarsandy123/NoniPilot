<Window x:Class="NoniPilot.Desktop.CameraCornerPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoniPilot - Camera" Height="170" Width="220"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#171A21" BorderBrush="#22D3EE" BorderThickness="1.5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="📷 Live Camera" Foreground="#EAF0FF" FontSize="11" FontWeight="Bold"
                       Margin="8,5,8,3" />

            <Border Grid.Row="1" Margin="6,0,6,6" CornerRadius="6" ClipToBounds="True" Background="#0D0F14">
                <Image x:Name="PreviewImage" Stretch="UniformToFill" />
            </Border>
        </Grid>
    </Border>
</Window>
