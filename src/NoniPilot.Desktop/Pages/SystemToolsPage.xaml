<UserControl x:Class="NoniPilot.Desktop.Pages.SystemToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <TextBlock Text="System Tools" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Power" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Shutdown/Restart schedule with a 30s delay so you can cancel; Lock is immediate." Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <UniformGrid Columns="4">
                        <Button Content="Lock" Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="Lock_Click" />
                        <Button Content="Shut down" Style="{StaticResource PillButton}" Margin="4,0,4,0"
                                Foreground="White" Background="{StaticResource Danger}" Click="Shutdown_Click" />
                        <Button Content="Restart" Style="{StaticResource PillButton}" Margin="4,0,4,0"
                                Foreground="White" Background="{StaticResource Warning}" Click="Restart_Click" />
                        <Button Content="Cancel pending" Style="{StaticResource PillButton}" Margin="4,0,0,0" Click="CancelPending_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Common shortcuts" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                    <UniformGrid Columns="3">
                        <Button Content="Alt+Tab" Style="{StaticResource PillButton}" Margin="0,0,4,4" Click="AltTab_Click" />
                        <Button Content="Task Manager" Style="{StaticResource PillButton}" Margin="4,0,4,4" Click="TaskManager_Click" />
                        <Button Content="Show Desktop" Style="{StaticResource PillButton}" Margin="4,0,0,4" Click="ShowDesktop_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0" MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="16,12">
                        <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource PillButton}" Click="Refresh_Click" />
                        <TextBlock Text="Running processes" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListView Grid.Row="1" x:Name="ProcessList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Window title" Width="360" DisplayMemberBinding="{Binding MainWindowTitle}" />
                                <GridViewColumn Header="Process" Width="160" DisplayMemberBinding="{Binding ProcessName}" />
                                <GridViewColumn Header="" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Close" Style="{StaticResource PillButton}" Padding="10,4" Click="CloseProcess_Click" Tag="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
