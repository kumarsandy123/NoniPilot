<UserControl x:Class="NoniPilot.Desktop.Pages.AiProvidersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NoniPilot.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="AI Providers" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <controls:StatusPill x:Name="LocalStatusPill" DockPanel.Dock="Right" />
                        <CheckBox x:Name="LocalCheckBox" Content="Local AI (Ollama) - always free, fully offline" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                        <TextBlock Text="Model:" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Width="60" />
                        <TextBox x:Name="OllamaModelTextBox" Width="180" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="6,4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <controls:StatusPill x:Name="GroqStatusPill" DockPanel.Dock="Right" />
                        <CheckBox x:Name="GroqCheckBox" Content="Groq Free Tier - fast cloud inference, needs a free API key" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Requires the GROQ_API_KEY environment variable to be set." Foreground="{StaticResource TextFaint}" Margin="20,0,0,4" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Margin="20,2,0,4">
                        <TextBlock Text="Model:" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Width="60" />
                        <TextBox x:Name="GroqModelTextBox" Width="220" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,4,0,4">
                        <TextBlock Text="Voice language:" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Width="90" />
                        <ComboBox x:Name="SpokenLanguageComboBox" Width="180" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <controls:StatusPill x:Name="ClaudeStatusPill" DockPanel.Dock="Right" />
                        <CheckBox x:Name="ClaudeCheckBox" Content="Cloud Paid Providers (Claude) - disabled by default" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Requires the ANTHROPIC_API_KEY environment variable and is a paid API." Foreground="{StaticResource TextFaint}" Margin="20,4,0,0" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Cost protection (always on, not a setting)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="- NoniPilot never adds a payment method or asks for one." Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                    <TextBlock Text="- A paid provider is only ever used if you enable it above AND its API key is present." Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                    <TextBlock Text="- If a provider errors, hits its rate limit, or there's no internet, the next one below it in this list is tried automatically." Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save" Style="{StaticResource PillButton}" Background="{StaticResource AccentGradient}" Foreground="White" Click="Save_Click" />
                <Button Content="Check status" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="CheckStatus_Click" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
