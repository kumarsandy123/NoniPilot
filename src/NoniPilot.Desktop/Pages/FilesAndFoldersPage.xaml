<UserControl x:Class="NoniPilot.Desktop.Pages.FilesAndFoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <TextBlock Text="Files &amp; Folders" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Up" Style="{StaticResource PillButton}" Click="Up_Click" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="PathBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="10,6" VerticalContentAlignment="Center"
                             KeyDown="PathBox_KeyDown" />
                    <Button Grid.Column="2" Content="Go" Style="{StaticResource PillButton}" Click="Go_Click" Margin="8,0,0,0"
                            Background="{StaticResource AccentGradient}" Foreground="White" />
                    <Button Grid.Column="3" Content="Refresh" Style="{StaticResource PillButton}" Click="Refresh_Click" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" MinHeight="360">
                    <ListView x:Name="EntriesList" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimary}"
                              MouseDoubleClick="EntriesList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Type" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextDim}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource TextDim}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Modified" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedLabel}" Foreground="{StaticResource TextDim}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Actions on selected item" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBox x:Name="ActionNameBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,0,6"
                                 ToolTip="New name / destination path, depending on the action" />
                        <UniformGrid Columns="2" Rows="2">
                            <Button Content="Rename" Style="{StaticResource PillButton}" Margin="0,0,4,4" Click="Rename_Click" />
                            <Button Content="Copy to..." Style="{StaticResource PillButton}" Margin="4,0,0,4" Click="Copy_Click" />
                            <Button Content="Move to..." Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="Move_Click" />
                            <Button Content="Delete" Style="{StaticResource PillButton}" Margin="4,0,0,0"
                                    Foreground="White" Background="{StaticResource Danger}" Click="Delete_Click" />
                        </UniformGrid>

                        <Separator Margin="0,14" />

                        <TextBlock Text="Create new" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBox x:Name="NewNameBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,0,6"
                                 ToolTip="Name of the new file or folder" />
                        <UniformGrid Columns="2">
                            <Button Content="New File" Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="NewFile_Click" />
                            <Button Content="New Folder" Style="{StaticResource PillButton}" Margin="4,0,0,0" Click="NewFolder_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Search" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SearchPatternBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,6,0"
                                 ToolTip="Name pattern, e.g. *.pdf" />
                        <TextBox Grid.Column="1" x:Name="SearchExtensionBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,6" Margin="6,0,6,0"
                                 ToolTip="Extension without the dot, e.g. pdf" />
                        <CheckBox Grid.Column="2" x:Name="RecursiveCheckBox" Content="Recursive" Foreground="{StaticResource TextDim}"
                                  VerticalAlignment="Center" IsChecked="True" Margin="6,0" />
                        <Button Grid.Column="3" Content="Search" Style="{StaticResource PillButton}"
                                Background="{StaticResource AccentGradient}" Foreground="White" Click="Search_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
