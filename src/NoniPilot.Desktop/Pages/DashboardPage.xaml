<UserControl x:Class="NoniPilot.Desktop.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NoniPilot.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="NoniPilot" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Cyan}" />
                        <TextBlock Text="Your Intelligent" FontSize="18" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Desktop Assistant" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock Text="I can see. I can hear. I can do." Foreground="{StaticResource TextDim}" FontStyle="Italic" />
                    </StackPanel>

                    <Ellipse Grid.Column="1" Width="140" Height="140" Fill="{StaticResource HeroGlowGradient}" Effect="{StaticResource GlowCyan}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="260">
                        <TextBlock x:Name="QuoteText" Foreground="{StaticResource TextDim}" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Right" FontSize="15" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Feature cards - each navigates to the page that actually backs it -->
            <UniformGrid Columns="6" Margin="0,0,0,16">
                <Button Style="{StaticResource QuickActionTile}" Margin="0,0,8,0" Click="FeatureVoice_Click"><StackPanel HorizontalAlignment="Center"><TextBlock Text="🎤" FontSize="22" HorizontalAlignment="Center" /><TextBlock Text="Voice" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock Text="Natural speech commands" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                <Button Style="{StaticResource QuickActionTile}" Margin="4,0" Click="FeatureVision_Click"><StackPanel HorizontalAlignment="Center"><TextBlock Text="👁" FontSize="22" HorizontalAlignment="Center" /><TextBlock Text="Vision" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock Text="Understand your screen" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                <Button Style="{StaticResource QuickActionTile}" Margin="4,0" Click="FeatureGesture_Click"><StackPanel HorizontalAlignment="Center"><TextBlock Text="✋" FontSize="22" HorizontalAlignment="Center" /><TextBlock Text="Gesture" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock Text="Control with hand movements" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                <Button Style="{StaticResource QuickActionTile}" Margin="4,0" Click="FeatureAiAgent_Click"><StackPanel HorizontalAlignment="Center"><TextBlock Text="🧠" FontSize="22" HorizontalAlignment="Center" /><TextBlock Text="AI Agent" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock Text="Plan, act, verify" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                <Button Style="{StaticResource QuickActionTile}" Margin="4,0" Click="FeatureComputer_Click"><StackPanel HorizontalAlignment="Center"><TextBlock Text="🖥" FontSize="22" HorizontalAlignment="Center" /><TextBlock Text="Computer" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock Text="Full desktop control" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
                <Button Style="{StaticResource QuickActionTile}" Margin="8,0,0,0" Click="FeatureAutomation_Click"><StackPanel HorizontalAlignment="Center"><TextBlock Text="⚙" FontSize="22" HorizontalAlignment="Center" /><TextBlock Text="Automation" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" /><TextBlock Text="Do more automatically" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Button>
            </UniformGrid>

            <!-- Main + side columns -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="⚡ Quick Actions" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </DockPanel>
                            <UniformGrid Columns="3" Rows="2">
                                <Button Style="{StaticResource QuickActionTile}" Margin="0,0,6,6" Click="OpenExplorer_Click">
                                    <StackPanel><TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="Open Explorer" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionTile}" Margin="6,0,6,6" Click="OpenChrome_Click">
                                    <StackPanel><TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="Open Chrome" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionTile}" Margin="6,0,0,6" Click="CreateFile_Click">
                                    <StackPanel><TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="Create New File" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionTile}" Margin="0,6,6,0" Click="Screenshot_Click">
                                    <StackPanel><TextBlock Text="📸" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="Take Screenshot" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionTile}" Margin="6,6,6,0" Click="SearchFiles_Click">
                                    <StackPanel><TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="Search Files" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickActionTile}" Margin="6,6,0,0" Click="Shutdown_Click">
                                    <StackPanel><TextBlock Text="⏻" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Danger}" /><TextBlock Text="Shutdown" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="View All" Style="{StaticResource PillButton}" Padding="10,4" Click="ViewAllTasks_Click" />
                                <TextBlock Text="🕐 Recent Tasks" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl x:Name="RecentTasksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeAgo}" Foreground="{StaticResource TextFaint}" FontSize="11" />
                                            <TextBlock Text="✅" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <controls:StatusPill DockPanel.Dock="Right" x:Name="LivePill" State="Connected" Text="Live" />
                                <Button DockPanel.Dock="Right" Content="&#x26F6;" FontSize="14" Style="{StaticResource IconButton}"
                                        Margin="0,0,8,0" ToolTip="Full screen" Click="FullScreen_Click" />
                                <TextBlock Text="🖥 Live Preview" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </DockPanel>
                            <Border Background="#171A21" Height="140" Cursor="Hand" MouseLeftButtonUp="LivePreview_Click">
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="⚡ AI Providers" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                            <ItemsControl x:Name="ProvidersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <controls:StatusPill DockPanel.Dock="Right" State="{Binding State}" Text="{Binding StateLabel}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextFaint}" FontSize="10" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="⚙ System Status" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </DockPanel>
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <controls:CircularGauge x:Name="CpuGauge" Label="CPU" AccentColor="{StaticResource Cyan}" />
                                <controls:CircularGauge x:Name="MemoryGauge" Label="Memory" AccentColor="{StaticResource Violet}" />
                                <controls:CircularGauge x:Name="DiskGauge" Label="Disk" AccentColor="{StaticResource Success}" />
                                <controls:CircularGauge x:Name="GpuGauge" Label="GPU" AccentColor="{StaticResource Warning}" />
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <controls:StatusPill x:Name="MicPill" Margin="0,0,4,4" />
                                <controls:StatusPill x:Name="CameraPill" Margin="4,0,0,4" />
                                <controls:StatusPill x:Name="GesturePill" Margin="0,0,4,0" />
                                <controls:StatusPill x:Name="ScreenPill" Margin="4,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Command bar -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Try saying:" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Open VS Code" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="Suggestion_Click" />
                        <Button Content="Create a folder named Backup" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="Suggestion_Click" />
                        <Button Content="Find my latest PDF" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="Suggestion_Click" />
                        <Button Content="Show system information" Style="{StaticResource ChipButton}" Click="Suggestion_Click" />
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MicButton" Grid.Column="0" Content="🎙" FontSize="18" Style="{StaticResource PillButton}"
                                Foreground="White" Margin="0,0,10,0" Effect="{StaticResource GlowCyan}" Click="Mic_Click">
                            <Button.Background>
                                <SolidColorBrush Color="#0E7A8C" />
                            </Button.Background>
                        </Button>

                        <Border Grid.Column="1" Background="#0E1420" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="22">
                            <TextBox x:Name="CommandBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource Cyan}" FontSize="15" Padding="16,10" VerticalContentAlignment="Center"
                                     Text="Type a command or speak..." KeyDown="CommandBox_KeyDown"
                                     GotFocus="CommandBox_GotFocus" />
                        </Border>

                        <Button Grid.Column="2" Content="Send" Style="{StaticResource PillButton}" Foreground="White" Margin="10,0,0,0"
                                Background="{StaticResource AccentGradient}" Effect="{StaticResource GlowViolet}" Click="Send_Click" />

                        <controls:ToggleSwitch x:Name="GestureModeToggle" Grid.Column="3" Caption="Gesture Mode" Margin="12,0,0,0" Toggled="GestureModeToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
