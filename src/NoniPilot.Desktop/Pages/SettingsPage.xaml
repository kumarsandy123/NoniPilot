<UserControl x:Class="NoniPilot.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Gesture calibration" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock x:Name="GestureSummaryText" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="Open Gesture Control" Style="{StaticResource PillButton}" Click="OpenGestureControl_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0">
                <StackPanel>
                    <TextBlock Text="Permission policy (built-in defaults)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="16,14,16,8" />
                    <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="16,0,16,8"
                               Text="Every action NoniPilot can take is classified into a risk tier before it runs. L0/L1 run automatically; L2/L3 always ask for confirmation. An action not listed here is treated as L2 (fails closed)." />
                    <ListView x:Name="PolicyList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" MaxHeight="320">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Scope" Width="260" DisplayMemberBinding="{Binding Scope}" />
                                <GridViewColumn Header="Risk level" Width="120" DisplayMemberBinding="{Binding RiskLevel}" />
                                <GridViewColumn Header="Default mode" Width="140" DisplayMemberBinding="{Binding ApprovalMode}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock x:Name="AboutText" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
