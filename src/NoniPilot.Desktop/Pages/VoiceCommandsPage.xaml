<UserControl x:Class="NoniPilot.Desktop.Pages.VoiceCommandsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoniPilot.Desktop"
             xmlns:controls="clr-namespace:NoniPilot.Desktop.Controls">
    <UserControl.Resources>
        <local:ChatEntryTemplateSelector x:Key="ChatTemplateSelector"
            UserTemplate="{StaticResource UserBubbleTemplate}"
            AssistantTemplate="{StaticResource AssistantBubbleTemplate}"
            SystemStepTemplate="{StaticResource SystemStepTemplate}"
            ErrorTemplate="{StaticResource ErrorTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="24,20,24,10">
            <controls:ToggleSwitch x:Name="WakeWordToggle" DockPanel.Dock="Right" Caption="Wake Word"
                                    ToolTip="When on, NoniPilot passively listens for &quot;Hey Noni&quot; / &quot;Jago Noni&quot; and starts the conversation automatically - no click needed."
                                    Toggled="WakeWordToggle_Toggled" />
            <Button x:Name="ClearChatButton" DockPanel.Dock="Right" Content="Clear Chat" Style="{StaticResource PillButton}"
                    Foreground="{StaticResource TextDim}" Padding="12,6" FontSize="12" Margin="0,0,14,0"
                    ToolTip="Clears the visible transcript and makes NoniPilot forget the conversation so far."
                    Click="ClearChatButton_Click" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Voice Commands" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="EngineText" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Bottom" Margin="12,0,0,3" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <ItemsControl x:Name="ChatItemsControl" ItemTemplateSelector="{StaticResource ChatTemplateSelector}" />
        </ScrollViewer>

        <Border Grid.Row="2" Margin="24,10,24,20" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0E1420" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="22">
                    <TextBox x:Name="CommandTextBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource Cyan}" FontSize="15" Padding="16,10"
                             VerticalContentAlignment="Center"
                             KeyDown="CommandTextBox_KeyDown"
                             ToolTip="Type a command, or click Talk, and press Enter" />
                </Border>

                <Button x:Name="TalkButton" Grid.Column="1" Content="Talk" Style="{StaticResource PillButton}"
                        Foreground="White" Margin="10,0,0,0" Effect="{StaticResource GlowCyan}"
                        Click="TalkButton_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#0E7A8C" />
                    </Button.Background>
                </Button>

                <Button x:Name="SendButton" Grid.Column="2" Content="Send" Style="{StaticResource PillButton}"
                        Foreground="White" Margin="10,0,0,0" Background="{StaticResource AccentGradient}"
                        Effect="{StaticResource GlowViolet}" Click="SendButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
