<UserControl x:Class="NoniPilot.Desktop.Pages.BrowserAutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <TextBlock Text="Browser Automation" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
            <TextBlock Text="Opens a URL in your default browser. Not a headless/DOM automation engine - just a real, reliable open." Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="UrlBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="10,6" VerticalContentAlignment="Center"
                             ToolTip="e.g. github.com or https://example.com" KeyDown="UrlBox_KeyDown" />
                    <Button Grid.Column="1" Content="Open" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                            Background="{StaticResource AccentGradient}" Foreground="White" Click="Open_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Bookmarks" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl x:Name="BookmarksList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,10,10" Width="140" Height="60">
                                    <Button Style="{StaticResource QuickActionTile}"
                                            Click="Bookmark_Click" Tag="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Url}" FontSize="10" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="✕" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                            Click="DeleteBookmark_Click" Tag="{Binding}" ToolTip="Delete bookmark" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NewBookmarkLabelBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,6,0" ToolTip="Label" />
                        <TextBox Grid.Column="1" x:Name="NewBookmarkUrlBox" Background="#0E1420" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,6" Margin="6,0" ToolTip="URL" />
                        <Button Grid.Column="2" Content="Add bookmark" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="AddBookmark_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <TextBlock Text="Recently opened" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="16,14,16,8" />
                    <ListView x:Name="RecentList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" MaxHeight="240">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding TimeLabel}" />
                                <GridViewColumn Header="URL" Width="400" DisplayMemberBinding="{Binding Url}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
