<UserControl x:Class="NoniPilot.Desktop.Pages.GestureControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Ellipse x:Name="PrivacyIndicator" Width="14" Height="14" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Gesture Control" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="16,12">
                            <DockPanel>
                                <Button x:Name="ToggleButton" DockPanel.Dock="Right" Content="Start Camera" Style="{StaticResource PillButton}"
                                        Background="{StaticResource AccentGradient}" Foreground="White" Click="ToggleButton_Click" />
                                <TextBlock x:Name="StatusText" Text="Camera off." Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="DiagnosticsText" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="#171A21" MinHeight="320" Margin="16,0,16,16">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Calibration" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,10" />

                        <TextBlock Text="Pinch sensitivity" Foreground="{StaticResource TextDim}" FontSize="12" />
                        <Slider x:Name="PinchSlider" Minimum="0.1" Maximum="0.6" TickFrequency="0.05" Margin="0,0,0,10" />

                        <TextBlock Text="Fist threshold" Foreground="{StaticResource TextDim}" FontSize="12" />
                        <Slider x:Name="FistSlider" Minimum="0.2" Maximum="0.6" TickFrequency="0.05" Margin="0,0,0,10" />

                        <TextBlock Text="Open palm threshold" Foreground="{StaticResource TextDim}" FontSize="12" />
                        <Slider x:Name="OpenPalmSlider" Minimum="0.5" Maximum="1.0" TickFrequency="0.05" Margin="0,0,0,10" />

                        <Button Content="Save calibration" Style="{StaticResource PillButton}" Click="SaveCalibration_Click" Margin="0,4,0,0" />

                        <Separator Margin="0,14" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextFaint}"
                                   Text="Point or open palm: move cursor - both track your hand, so cursor control works whether your hand is relaxed-open or pointing. Quick pinch (thumb+index touch then release right away): click, at wherever the cursor is. Pinch and hold while moving: drag - pick up a file/folder and drop it wherever you release. While pinched, pull your hand toward the camera to zoom in, or away to zoom out. Hand swept fast left/right: move the focused window to the next/previous connected monitor (requires more than one monitor to see an effect). Peace sign (index+middle up, others down): close the currently focused window - refuses to close NoniPilot's own window if that's what's focused. Three fingers up (index+middle+ring, pinky down): open a new File Explorer window. Fist: emergency stop. Thumbs up/down are recognized but not yet wired to actions. Hold your hand roughly centered in the preview, well lit." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Face Recognition" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBlock x:Name="FaceStatusText" Text="Not enrolled yet." Foreground="{StaticResource TextDim}" Margin="0,0,0,10" />
                    <Button x:Name="EnrollButton" Content="Enroll My Face" Style="{StaticResource PillButton}"
                            Background="{StaticResource AccentGradient}" Foreground="White" HorizontalAlignment="Left"
                            Click="EnrollButton_Click" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,10,0,0"
                               Text="Look at the camera and click Enroll - it captures a few seconds of your face so NoniPilot can recognize you later (e.g. 'do you recognize me?'). Runs entirely on this PC; nothing is uploaded anywhere. Re-enrolling replaces the previous enrollment." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
