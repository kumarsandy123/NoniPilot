<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base palette, promoted from the original single-window MainWindow so every page shares
         one set of brushes instead of each window hardcoding its own slightly-different hex
         values (the old AiProvidersWindow/GestureCenterWindow each had their own). -->
    <SolidColorBrush x:Key="Bg" Color="#090B10" />
    <SolidColorBrush x:Key="Panel" Color="#12151C" />
    <SolidColorBrush x:Key="PanelElevated" Color="#171B26" />
    <SolidColorBrush x:Key="PanelBorder" Color="#232838" />
    <SolidColorBrush x:Key="TextPrimary" Color="#EAF0FF" />
    <SolidColorBrush x:Key="TextDim" Color="#8891A8" />
    <SolidColorBrush x:Key="TextFaint" Color="#5B6478" />
    <SolidColorBrush x:Key="Cyan" Color="#22D3EE" />
    <SolidColorBrush x:Key="Violet" Color="#8B5CF6" />
    <SolidColorBrush x:Key="Danger" Color="#F43F5E" />
    <SolidColorBrush x:Key="Success" Color="#22C55E" />
    <SolidColorBrush x:Key="Warning" Color="#F59E0B" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22D3EE" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UserBubbleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5B7" Offset="0" />
        <GradientStop Color="#6D28D9" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HeroGlowGradient">
        <GradientStop Color="#5522D3EE" Offset="0" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="GlowCyan" Color="#22D3EE" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="GlowViolet" Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.4" />
    <DropShadowEffect x:Key="GlowDanger" Color="#F43F5E" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="GlowSuccess" Color="#22C55E" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
    <DropShadowEffect x:Key="GlowWarning" Color="#F59E0B" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />

</ResourceDictionary>
