<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Pill / icon-style buttons used across the header, input bar and dialogs. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round icon-only button, used for the header's window controls (minimize/maximize/close). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelElevated}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation row. -->
    <Style x:Key="SidebarNavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="AccentBar" Grid.Column="0" Width="3" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentGradient}"
                                       Visibility="Collapsed" HorizontalAlignment="Left" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0C111826" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelElevated}" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card container used for panels/tiles throughout the dashboard. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Quick-action tile: icon on top, label below, glow on hover. -->
    <Style x:Key="QuickActionTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource GlowCyan}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small pill chip, used for the Dashboard's suggested-command chips. -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    </Style>

    <!-- Chat bubble templates - unchanged from the original single-window chat UI, reused by
         VoiceCommandsPage and AutomationPage's run-log. -->
    <DataTemplate x:Key="UserBubbleTemplate">
        <StackPanel HorizontalAlignment="Right" Margin="80,6,4,6" MaxWidth="620">
            <Border Background="{StaticResource UserBubbleGradient}" CornerRadius="16,16,2,16" Padding="14,10">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White" FontSize="14" />
            </Border>
            <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource TextDim}" FontSize="10"
                       HorizontalAlignment="Right" Margin="0,3,4,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AssistantBubbleTemplate">
        <StackPanel HorizontalAlignment="Left" Margin="4,6,80,6" MaxWidth="620">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="16,16,16,2" Padding="14,10">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="14" />
            </Border>
            <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource TextDim}" FontSize="10" Margin="4,3,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SystemStepTemplate">
        <Border HorizontalAlignment="Center" Background="#0E1420" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,3">
            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextDim}" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ErrorTemplate">
        <Border HorizontalAlignment="Center" Background="#2A1220" BorderBrush="{StaticResource Danger}"
                BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,4" MaxWidth="700">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="#FFB4C6" />
        </Border>
    </DataTemplate>

</ResourceDictionary>
